<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net7.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>WuGing.VectorTileRenderer</RootNamespace>
    <AssemblyName>WuGing.VectorTileRenderer</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>true</IsPackable>
    <PackageId>WuGing.VectorTileRenderer</PackageId>
    <Version>0.1.1-preview.7</Version>
    <Authors>VectorTileRenderer Contributors</Authors>
    <Company>VectorTileRenderer Contributors</Company>
    <Description>Vector map tile renderer for .NET with style-based rendering for MBTiles and PBF sources.</Description>
    <PackageReleaseNotes>0.1.1-preview.7&#10;- Add direct cached PNG output for byte-oriented clients, including the Mapsui demo.&#10;- Harden cache source identity, corrupt-entry recovery, atomic publication and explicit pruning.&#10;- Reduce PBF decoding allocations with direct renderer-feature and geometry conversion.&#10;- Speed lossless vector PNG encoding and reuse layer brushes, native paths and paints while preserving exact CPU pixels.&#10;- Refresh render-time feature dependencies after mutable style edits and reject nonadvancing malformed geometry.&#10;- Add paired CPU request measurements, decode compatibility tests and packaged third-party notices.&#10;- Use SDK-provided Source Link to resolve the restore-time package audit failure.&#10;- GPU support remains experimental; cross-tile label placement and Unicode shaping/fallback remain incomplete.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.NUGET.md</PackageReadmeFile>
    <PackageTags>maps;vector-tiles;mbtiles;openmaptiles;mapbox;skia</PackageTags>
    <RepositoryUrl>https://github.com/WuGing/VectorTileRenderer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/WuGing/VectorTileRenderer</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="mapbox-vector-tile" Version="5.3.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.2" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.NUGET.md" Pack="true" PackagePath="\" Visible="false" />
    <None Remove="THIRD-PARTY-NOTICES.txt" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
